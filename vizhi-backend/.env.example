# The one database: PostgreSQL (Supabase or Neon). Paste the connection string
# as-is (any of postgresql://, postgres:// or postgresql+asyncpg://; libpq-only
# params such as `sslmode=require&channel_binding=require` are translated for
# asyncpg). Use the session pooler (port 5432) on Supabase.
# Schema: `alembic upgrade head` before starting the server.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# "auto" routes each provider to its own backend (openai → OpenAI,
# nvidia → NVIDIA NIM, huggingface → HF, …). Use a comma-separated list
# (e.g. "custom,huggingface") to force a legacy override order.
INFERENCE_BACKEND=auto
HF_TOKEN=hf_your_token_here
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
NVIDIA_API_KEY=nvapi-your-token-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: map Vizhi aliases to real backend model ids.
INFERENCE_MODEL_MAP={"llama/meta-llama/Llama-3.1-8B-Instruct":"meta-llama/Llama-3.1-8B-Instruct:fastest"}

# Tomorrow: switch to your own OpenAI-compatible deployment.
# INFERENCE_BACKEND=custom
# CUSTOM_INFERENCE_BASE_URL=https://your-endpoint/v1
# CUSTOM_INFERENCE_API_KEY=your_key

# Optional fallback order: try custom first, then Hugging Face.
# INFERENCE_BACKEND=custom,huggingface

# Frontend session cookie (HttpOnly JWT)
# AUTH_COOKIE_NAME=vizhi_session
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax
