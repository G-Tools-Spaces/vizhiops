# The same PostgreSQL database the gateway uses (Supabase or Neon). Paste the
# connection string as-is; `sslmode=require` and a `postgresql+asyncpg://`
# prefix are both handled.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Must match the gateway's AUTH_JWT_SECRET so one sign-in works in both
# consoles (the gateway's default is "change-me-in-production").
AUTH_JWT_SECRET=change-me-in-production
# AUTH_JWT_ISSUER=vizhi
# AUTH_COOKIE_NAME=vizhi_session
# Set to true behind HTTPS (Render).
AUTH_COOKIE_SECURE=false

# Optional: keys for the "Sync models" buttons on the built-in providers.
# NVIDIA_API_KEY=nvapi-...
# HF_TOKEN=hf_...
